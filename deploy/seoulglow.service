# systemd — Seoul Glow (Next.js)
#
# Instalación:
#   sudo cp deploy/seoulglow.service /etc/systemd/system/seoulglow.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now seoulglow
#   systemctl status seoulglow
#
# Ajustar las rutas si el repositorio se clona en otro directorio.
# El usuario debe poder leer web/.env.local (permisos 600).

[Unit]
Description=Seoul Glow - Next.js
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
User=andreleon
Group=andreleon
WorkingDirectory=/home/andreleon/Documentos/seoulglow/web
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=PATH=/home/andreleon/.nvm/versions/node/v26.13.0/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/andreleon/Documentos/seoulglow/web/.env.local
ExecStart=/home/andreleon/.nvm/versions/node/v26.13.0/bin/node /home/andreleon/Documentos/seoulglow/web/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
